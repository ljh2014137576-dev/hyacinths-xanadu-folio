{
  "name": "xanadu-code-flow-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "description": "Local-first Xanadu-style TypeScript code flow browser",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "npm run build && electron .",
    "build": "rimraf dist dist-electron && npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc6 -p tsconfig.electron.json && vite build --config vite.preload.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc6 -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "node scripts/capture-screenshots.mjs",
    "license:check": "node scripts/check-licenses.mjs"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.1.0",
    "eslint": "10.9.1",
    "jsdom": "30.0.1",
    "rimraf": "6.1.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wait-on": "9.1.0"
  }
}
